{
  "appId": "vn.aicf.mobile",
  "appName": "AICF Coffee",
  "webDir": "www",
  "backgroundColor": "#faf4ea",
  "server": {
    "androidScheme": "http"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorSQLite": {
      "androidIsEncryption": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
