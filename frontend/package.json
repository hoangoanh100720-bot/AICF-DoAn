{
  "name": "aicf-coffee-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AICF Coffee cho chủ quán, quản lý, nhân viên (PWA + Android bằng Capacitor)",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "build:apk": "cap sync android && cd android && gradlew.bat assembleDebug",
    "test:e2e": "node tests/e2e.mjs",
    "test:load": "node --no-warnings tests/load.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
